.venv/
__pycache__/
*.py[cod]
.coverage
htmlcov/
build/
dist/
*.egg-info/
tmp/
.worktrees/

# Local reports and TeX build products that are not package sources.
/IRP_Project_Plan.*
/custom_data_report.html
/missfont.log
/output/pdf/*.aux
/output/pdf/*.lof
/output/pdf/*.log
/output/pdf/*.lot
/output/pdf/*.out
/output/pdf/*.toc

# Uncompressed/intermediate STAR downloads. The committed case study keeps the
# deterministic gzip export and the official user guide.
/case_studies/tennessee_star/data/raw/STAR_Students.tab
/case_studies/tennessee_star/data/raw/STAR.csv

# PPT Master transient exports and visual-QA renders. The editable SVG source,
# design lock, notes, source bundle, and stable output/ppt deliverables remain
# versioned.
/projects/*/backup/
/projects/*/exports/
/projects/*/live_preview/
/projects/*/validation/*
!/projects/*/validation/chart_verification_receipt.md
/projects/fci_plus_star_research.md
/projects/fci_plus_star_research.facts.json
/output/ppt/*_pdf_pages/
